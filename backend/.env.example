PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_db

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

MANAGER_NAME=Store Manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace_with_a_strong_password

CLIENT_URL=http://localhost:4200

STORE_NAME=My Store
STORE_PHONE=+201000000000
STORE_CURRENCY=EGP

# SMTP settings for order confirmation emails
# Mailpit defaults (SMTP: 1025, web inbox: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=My Store <no-reply@example.com>

# Cookie settings (use COOKIE_SAME_SITE=none only when the frontend and API are on different sites, over HTTPS)
COOKIE_SAME_SITE=lax

# Paymob hosted checkout (use test credentials during development)
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# Must be a public HTTPS URL for Paymob callbacks (use a tunnel for local development)
PAYMOB_WEBHOOK_URL=
PAYMOB_REDIRECT_URL=http://localhost:4200/order-success
